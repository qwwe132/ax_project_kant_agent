OPENAI_API_KEY=

#postgresql+psycopg://postgres:postgres@localhost:5432/postgres
DATABASE_URL=

# 검색 설정(선택). 비우면 기본값을 쓴다.
# 검색할 컬렉션 (기본 kant_docs, 샘플은 kant_docs_sample)
